# bulk-fill-posters.js 용 환경변수 템플릿
# 이 파일을 .env 로 복사한 뒤 값을 채우세요 (.env 는 .gitignore 로 커밋 제외됨).
#
#   PowerShell:  Copy-Item .env.example .env
#
# ⚠️ SUPABASE_SERVICE_ROLE_KEY 는 DB 전권 키입니다. 절대 커밋/공유 금지.
#    노출 시 Supabase 대시보드 → Settings → API 에서 즉시 rotate.

# Supabase 프로젝트 URL (예: https://xxxx.supabase.co)
SUPABASE_URL=

# service_role 키 (Settings → API → service_role, secret) — RLS 우회용, 비공개
SUPABASE_SERVICE_ROLE_KEY=

# TMDB v3 API key (미설정 시 AniList 만으로 검색)
TMDB_API_KEY=
